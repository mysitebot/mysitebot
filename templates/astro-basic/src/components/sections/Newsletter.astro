---
import { resolvePath } from '../../utils/paths';
/**
 * Newsletter Component - A mailing-list signup form. On submit it emails the
 * site owner that someone wants to subscribe (same backend as the contact form,
 * so no separate setup is needed). Add it whenever a user wants a newsletter or
 * email signup.
 * NOTE: this component collects an email address ONLY. If the request asks
 * for any additional named field (e.g. first name, last name, phone), use the
 * ContactForm component with a `fields` array instead — Newsletter cannot
 * render extra fields.
 */
interface Props {
  /** Optional anchor id for in-page links (e.g. href="#signup") */
  id?: string;
  /** The main title for the newsletter (e.g., "Join our newsletter") */
  heading: string;
  /** Supporting text (e.g., "Stay updated with our latest collections") */
  subheading?: string;
  /** Placeholder text for the email input field */
  placeholder?: string;
  /** Label for the submit button */
  buttonLabel?: string;
  /** Optional image for split layout */
  image?: { src: string; alt: string; };
  /** Layout style: 'stacked' (default) or 'split' (image on left, form on right) */
  layout?: 'stacked' | 'split';
  /** Background color (Tailwind class, e.g., 'bg-indigo-600') */
  backgroundColor?: string;
  /** Base text color for headings and body text (Tailwind class, e.g., 'text-white'). Use when backgroundColor is dark. */
  textColor?: string;
  /** Button color (Tailwind class, e.g., 'bg-pink-500'). Defaults to inheriting from section styling. */
  buttonColor?: string;
}

type Slots = {
  default?: any;
};

import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';

const {
  id,
  heading = "Subscribe to our newsletter",
  subheading = "Get the latest news and updates delivered straight to your inbox.",
  placeholder = "Enter your email",
  buttonLabel = "Subscribe",
  image,
  layout = 'stacked',
  backgroundColor = 'bg-indigo-600',
  textColor,
  buttonColor,
} = Astro.props;

const { default: slot } = Astro.slots;

// Unique id so each instance's <label> associates with its own input, even
// when several Newsletter sections appear on the same page.
const emailInputId = `newsletter-email-${Math.random().toString(36).slice(2, 8)}`;
---

{layout === 'split' && image ? (
  <section id={id} role="region" aria-label="Newsletter" class={`py-16 px-6 ${backgroundColor} my-16 max-w-6xl mx-auto overflow-hidden rounded-3xl shadow-sm`}>
    <div class="flex flex-col md:flex-row gap-0">
      <div class="w-full md:w-1/2 overflow-hidden min-h-[220px] md:min-h-0">
        <img src={resolvePath(image.src)} alt={image.alt} loading="lazy" class="w-full h-full object-cover" />
      </div>
      <div class="w-full md:w-1/2 flex flex-col justify-center px-6 py-8 md:px-12 md:py-16 bg-gray-50">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 tracking-tight">
          {heading}
        </h2>
        {subheading && (
          <p class="text-gray-600 text-lg mb-8 leading-relaxed">
            {subheading}
          </p>
        )}
        <form class="flex flex-col gap-4" data-newsletter-form>
          <label for={emailInputId} class="sr-only">Email address</label>
          <Input
            id={emailInputId}
            type="email"
            name="email"
            autocomplete="email"
            placeholder={placeholder}
            required
            class="bg-white border-gray-300 text-gray-900 placeholder:text-gray-500 focus:border-indigo-500"
          />
          <Button type="submit" variant="unstyled" class={`${buttonColor ?? 'bg-blue-500'} text-white hover:opacity-90 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-current border-none px-6 py-3 whitespace-nowrap`}>
            {buttonLabel}
          </Button>
        </form>
        <div class="hidden mt-4 p-3 rounded-xl bg-green-100 text-green-800 text-center text-sm font-medium" role="status" data-newsletter-success>
          Thanks for signing up — we'll be in touch!
        </div>
        <div class="hidden mt-4 p-3 rounded-xl bg-red-100 text-red-800 text-center text-sm font-medium" role="alert" data-newsletter-error></div>
        {slot && (
          <div class="mt-6 text-gray-700">
            <slot />
          </div>
        )}
      </div>
    </div>
  </section>
) : (
  <section id={id} role="region" aria-label="Newsletter" class={`py-16 px-6 ${backgroundColor} rounded-3xl my-16 max-w-6xl mx-auto overflow-hidden relative`}>
    <!-- Decorative background circles -->
    <div aria-hidden="true" class="absolute -top-24 -right-24 w-64 h-64 bg-indigo-500 rounded-full opacity-50 blur-3xl"></div>
    <div aria-hidden="true" class="absolute -bottom-32 -left-20 w-72 h-72 bg-white rounded-full opacity-10 blur-3xl"></div>

    <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-10">
      <div class="flex-1 text-center md:text-left">
        <h2 class={`text-3xl md:text-4xl font-bold mb-4 tracking-tight ${textColor ?? 'text-white'}`}>
          {heading}
        </h2>
        {subheading && (
          <p class={`text-lg max-w-xl leading-relaxed ${textColor ?? 'text-indigo-100'}`}>
            {subheading}
          </p>
        )}
      </div>

      <div class="flex-1 w-full max-w-md">
        <form class="flex flex-col sm:flex-row gap-4" data-newsletter-form>
          <div class="flex-1">
            <label for={emailInputId} class="sr-only">Email address</label>
            <Input
              id={emailInputId}
              type="email"
              name="email"
              autocomplete="email"
              placeholder={placeholder}
              required
              class="bg-white/10 border-white/20 text-white placeholder:text-indigo-200 focus:bg-white/20"
            />
          </div>
          <Button type="submit" variant="unstyled" class={`${buttonColor ? `${buttonColor} text-white` : 'bg-white text-indigo-600'} hover:opacity-90 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white/70 border-none px-8 whitespace-nowrap`}>
            {buttonLabel}
          </Button>
        </form>
        <div class="hidden mt-4 p-3 rounded-xl bg-green-100 text-green-800 text-center text-sm font-medium" role="status" data-newsletter-success>
          Thanks for signing up — we'll be in touch!
        </div>
        <div class="hidden mt-4 p-3 rounded-xl bg-red-100 text-red-800 text-center text-sm font-medium" role="alert" data-newsletter-error></div>
      </div>
    </div>
    {slot && (
      <div class="relative z-10 mt-6">
        <slot />
      </div>
    )}
  </section>
)}

<script>
  // Same backend as ContactForm: POST the email to the site's form endpoint,
  // which emails the owner "someone wants to subscribe" (form_type=newsletter).
  const endpoint = document.querySelector('meta[name="mysitebot:form-endpoint"]')?.getAttribute('content') || '';
  const projectId = document.querySelector('meta[name="mysitebot:project-id"]')?.getAttribute('content') || '';

  document.querySelectorAll('[data-newsletter-form]').forEach(form => {
    const el = form as HTMLFormElement;
    const parent = el.parentElement;
    const successMsg = parent?.querySelector('[data-newsletter-success]');
    const errorMsg = parent?.querySelector('[data-newsletter-error]');

    const showSuccess = () => {
      el.reset();
      errorMsg?.classList.add('hidden');
      successMsg?.classList.remove('hidden');
    };
    const showError = (msg: string) => {
      if (errorMsg) { errorMsg.textContent = msg; errorMsg.classList.remove('hidden'); }
    };

    el.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Not wired to a backend (e.g. local template preview): keep the
      // optimistic confirmation rather than erroring.
      if (!endpoint || !projectId) { showSuccess(); return; }

      const data = new FormData(el);
      data.append('project_id', projectId);
      data.append('form_type', 'newsletter');
      const btn = el.querySelector('[type="submit"]') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data });
        if (res.ok) showSuccess();
        else showError("Sorry, we couldn't sign you up right now. Please try again.");
      } catch {
        showError("Sorry, we couldn't sign you up right now. Please try again.");
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  });
</script>
