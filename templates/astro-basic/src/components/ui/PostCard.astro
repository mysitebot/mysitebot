---
import { resolvePath } from '../../utils/paths';
import { formatDate, type Post } from '../../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, excerpt, description, image } = post.data;
const summary = excerpt ?? description;
const href = resolvePath(`/blog/${post.slug}`);
---

<article class="flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
  {image && (
    <a href={href} class="block aspect-[16/9] overflow-hidden">
      <img src={resolvePath(image.src)} alt={image.alt} class="w-full h-full object-cover" />
    </a>
  )}
  <div class="flex flex-col flex-1 p-6">
    <time datetime={date.toISOString()} class="text-sm text-gray-500 mb-2">{formatDate(date)}</time>
    <h3 class="text-xl font-semibold text-gray-900 mb-2">
      <a href={href} class="hover:text-indigo-600">{title}</a>
    </h3>
    {summary && <p class="text-gray-600 flex-1">{summary}</p>}
    <a href={href} class="mt-4 text-indigo-600 font-medium hover:underline">Read more &rarr;</a>
  </div>
</article>
