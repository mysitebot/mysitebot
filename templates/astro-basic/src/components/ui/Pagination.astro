---
import { resolvePath } from '../../utils/paths';

interface Props {
  page: {
    url: { prev?: string; next?: string };
    currentPage: number;
    lastPage: number;
  };
}

const { page } = Astro.props;
---

{(page.url.prev || page.url.next) && (
  <nav class="mt-14 flex items-center justify-between" aria-label="Pagination">
    {page.url.prev
      ? <a href={resolvePath(page.url.prev)} class="text-indigo-600 hover:underline">&larr; Newer posts</a>
      : <span></span>}
    <span class="text-sm text-gray-500">Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next
      ? <a href={resolvePath(page.url.next)} class="text-indigo-600 hover:underline">Older posts &rarr;</a>
      : <span></span>}
  </nav>
)}
